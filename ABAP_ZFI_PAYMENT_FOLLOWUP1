*&---------------------------------------------------------------------*
*& Form get_build_data
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_build_data .

"select open line items from BSID
  select bukrs, kunnr, AUGBL, gjahr, belnr, budat, waers, xblnr, blart, dmbtr, ZFBDT, zbd1t
         from bsid into TABLE @data(gt_bsid)
         WHERE bukrs in @s_bukrs
           and kunnr in @s_kunnr
           and blart in @s_blart.

"cleared line items
  select bukrs, kunnr, AUGBL, gjahr, belnr, budat, waers, xblnr, blart, dmbtr, ZFBDT, zbd1t
         from bsad appending TABLE @gt_bsid
         WHERE bukrs in @s_bukrs
           and kunnr in @s_kunnr
           and blart in @s_blart.

  IF GT_BSID[] is NOT INITIAL.

     sort GT_BSID by kunnr.

  select kunnr, name1, adrnr from kna1 into TABLE @data(gt_kna1)
  FOR ALL ENTRIES IN @GT_BSID WHERE kunnr = @GT_BSID-kunnr.

   IF GT_KNA1[] is NOT INITIAL.

  sort gt_kna1 by adrnr.

  select * from adr2 into TABLE @data(gt_adr2)
  FOR ALL ENTRIES IN @gt_kna1 WHERE addrnumber = @gt_kna1-adrnr.


   endif.

  sort GT_BSID by bukrs belnr gjahr.

  "select the existing remarks
  select * from ZFIPAY_REMARKS into TABLE @data(gt_remarks)
  FOR ALL ENTRIES IN @gt_bsid WHERE bukrs = @gt_bsid-bukrs
                                and belnr = @gt_bsid-belnr
                                and gjahr = @gt_bsid-gjahr.


  sort gt_kna1 by kunnr.
  sort gt_adr2 by addrnumber.

  clear : gt_list[], gs_list.

  loop at gt_bsid ASSIGNING FIELD-SYMBOL(<fs>).

  clear : gs_list.
          MOVE-CORRESPONDING <fs> to gs_list.

"customer name

   try.
     data(gs_kna1) = gt_kna1[ kunnr = <fs>-kunnr ].
   CATCH cx_root.
     clear : gs_kna1.
   endtry.

   try.
     data(gs_adr2) = gt_adr2[ addrnumber = gs_kna1-adrnr ].
   catch cx_root.
   endtry.


    try.
     data(gs_remarks) = gt_remarks[ bukrs = <fs>-bukrs belnr = <fs>-belnr gjahr = <fs>-gjahr ].
    CATCH cx_root.
    ENDTRY.


    gs_list-due_date = <fs>-zfbdt + <fs>-zbd1t.
    gs_list-name1    = gs_kna1-name1.
    gs_list-telnr_long = gs_adr2-telnr_long.

    gs_list-remarks   = gs_remarks-remarks.
    gs_list-pdate     = gs_remarks-pdate.
    gs_list-AUGBL     = <fs>-augbl.

    if <fs>-AUGBL is INITIAL.
       gs_list-status = ICON_RED_LIGHT.
    else.
       gs_list-status = ICON_GREEN_LIGHT.
    endif.

    if <fs>-blart = 'DZ'.
       gs_list-status = ICON_YELLOW_LIGHT.
    endif.


*    gs_list-red     = icon_red_light.
*    gs_list-green   = ICON_GREEN_LIGHT.
*    gs_list-yellow  = ICON_YELLOW_LIGHT.

    append gs_list to gt_list.


   clear : gs_list, gs_kna1, gs_adr2, gs_remarks.
  endloop.

    GT_LIST1[] = GT_LIST[].


  else.
     message 'No data found' TYPE 'I'.

  endif.

ENDFORM.
