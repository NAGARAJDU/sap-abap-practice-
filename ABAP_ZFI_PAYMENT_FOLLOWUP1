SELECTION-SCREEN begin of BLOCK b1 WITH FRAME TITLE text-001.
  select-OPTIONS : s_kunnr for bsid-kunnr,
                   s_blart for bsid-blart DEFAULT 'RV',
                   s_bukrs for bsid-bukrs.
