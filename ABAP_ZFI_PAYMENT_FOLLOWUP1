*&---------------------------------------------------------------------*
*& Form save_data
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM save_data .

    data : lv_flag type flag,
           gs_log type ZFIPAY_REMARKS_L.


    loop at gt_list ASSIGNING FIELD-SYMBOL(<fs1>).

    read TABLE gt_list1 into gs_list with key bukrs = <fs1>-bukrs
                                              belnr = <fs1>-belnr
                                              gjahr = <fs1>-gjahr.

    if sy-subrc = 0 and ( <fs1>-remarks ne gs_list-remarks  or
                          <fs1>-pdate ne gs_list-pdate ).


      clear : gs_log.
      select SINGLE * from zfipay_remarks
      into CORRESPONDING FIELDS OF gs_log WHERE  bukrs = <fs1>-bukrs
                                            and  belnr = <fs1>-belnr
                                            and  gjahr = <fs1>-gjahr.

      if sy-subrc = 0.
         gs_log-modby   = sy-uname.
         gs_log-modon   = sy-datum.
         gs_log-modtime = sy-uzeit.
         modify zfipay_remarks_l from gs_log.
      endif.


      clear : gs_remarks.
      MOVE-CORRESPONDING <fs1> to gs_remarks .
      gs_remarks-createdby  = sy-uname.
      gs_remarks-createdon  = sy-datum.
      gs_remarks-time       = sy-uzeit.
      modify zfipay_remarks from gs_remarks.
      clear : gs_remarks.

      lv_flag = 'X'.

    endif.


    clear : gs_list.
    endloop.


     IF lv_flag = 'X'.
         MESSAGE 'Record saved successfully' TYPE 'I'.
     endif.

    gt_list1[] = gt_list[].

   clear : lv_flag.
ENDFORM.
